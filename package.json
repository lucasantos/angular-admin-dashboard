{
  "name": "admin-dashboard",
  "version": "0.1.0",
  "description": "Modern Angular Admin Dashboard Template",
  "license": "GPL-3.0-only",
  "scripts": {
    "ng": "ng",
    "start": "concurrently --kill-others-on-fail \"ng serve\" \"json-server ./src/app/mocks/db.json --port 3000\"",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "serve:ssr:admin-dashboard": "node dist/admin-dashboard/server/server.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\""
  },
  "private": true,
  "packageManager": "yarn@1.22.4",
  "dependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/platform-server": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.0",
    "@angular/ssr": "^22.0.0",
    "@jsverse/transloco": "^8.3.0",
    "express": "^5.1.0",
    "ngx-quill": "^30.1.3",
    "quill": "^2.0.3",
    "rxjs": "~7.8.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.0",
    "@angular/cli": "^22.0.0",
    "@angular/compiler-cli": "^22.0.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "concurrently": "^9.2.1",
    "jsdom": "^28.0.0",
    "json-server": "^1.0.0-beta.15",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.0.10"
  }
}
